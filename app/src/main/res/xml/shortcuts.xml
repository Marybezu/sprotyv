<?xml version="1.0" encoding="utf-8"?>
<!-- A long press on Sprotyv's icon: three ways in. Not on the neutral icon -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="now" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_now" android:shortcutLongLabel="@string/tile_now">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="ua.sprotyv" android:targetClass="ua.sprotyv.ui.Main">
            <extra android:name="ua.sprotyv.open" android:value="now" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="safe" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_safe" android:shortcutLongLabel="@string/tile_safe">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="ua.sprotyv" android:targetClass="ua.sprotyv.ui.Main">
            <extra android:name="ua.sprotyv.open" android:value="safe" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="tourniquet" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_tourniquet" android:shortcutLongLabel="@string/shortcut_tourniquet_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="ua.sprotyv" android:targetClass="ua.sprotyv.ui.Main">
            <extra android:name="ua.sprotyv.open" android:value="bleeding" />
        </intent>
    </shortcut>
</shortcuts>
