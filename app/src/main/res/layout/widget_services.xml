<?xml version="1.0" encoding="utf-8"?>
<!-- Emergency numbers: a tap opens the phone's dialler with the number; the call is the owner's -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_shape_plain" android:orientation="horizontal" android:padding="6dp">
    <TextView android:id="@+id/w_s1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp"
        android:background="@drawable/w_shape_button" android:gravity="center" android:text="112" android:textColor="@color/w_red"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_s2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp"
        android:background="@drawable/w_shape_button" android:gravity="center" android:text="101" android:textColor="@color/w_ink"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_s3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp"
        android:background="@drawable/w_shape_button" android:gravity="center" android:text="102" android:textColor="@color/w_ink"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_s4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp"
        android:background="@drawable/w_shape_button" android:gravity="center" android:text="103" android:textColor="@color/w_ink"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_s5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="3dp"
        android:background="@drawable/w_shape_button" android:gravity="center" android:text="104" android:textColor="@color/w_ink"
        android:textSize="18sp" android:textStyle="bold" />
</LinearLayout>
