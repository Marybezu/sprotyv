<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Release 1.0 has no internet at all: removed even if a library asks for it.
         CI stops the build if any permission outside its short list appears. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- The settings lock asks for the phone's own PIN in Android's own window. An ordinary
         permission with no prompt; the app never sees the PIN -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notifications the owner switches on (all off by default): Android asks the owner first -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are lost when the phone restarts: planned again from what is on -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Opening WhatsApp, Signal and the SMS app by name needs Android to tell they are installed -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.thoughtcrime.securesms" />
        <!-- "Situation" opens these official apps when installed: the air alert app and 112 Ukraine -->
        <package android:name="com.ukrainealarm" />
        <package android:name="ua.gov.mvs.service112" />
        <!-- Firefox Focus erases pages on closing: used for "Situation" when installed -->
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.klar" />
        <!-- Google Play: whether a link to Firefox Focus there can be offered -->
        <package android:name="com.android.vending" />
        <!-- Apps that open https links: to find the main browser -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- The phone's own camera app takes the picture of a QR code: no camera permission here -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sprotyv"
        tools:targetApi="36">
        <activity
            android:name=".ui.Main"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />
        <!-- Two home-screen entries, one on at a time: "Sprotyv", or a neutral "Notes" (settings) -->
        <!-- The usual entry keeps the activity's old name, so icons already on home screens keep working -->
        <activity-alias
            android:name=".ui.MainActivity"
            android:targetActivity=".ui.Main"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on the icon: three ways in (the neutral icon has none) -->
        </activity-alias>
        <activity-alias
            android:name=".LauncherNeutral"
            android:targetActivity=".ui.Main"
            android:exported="true"
            android:enabled="false"
            android:label="@string/neutral_name"
            android:icon="@mipmap/ic_neutral">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- "Share → Sprotyv" from a browser keeps a page among the owner's bookmarks. Off until
             set up, and off with the neutral icon, in trip mode and in kid mode (ShareIn) -->
        <activity-alias
            android:name=".ShareIn"
            android:targetActivity=".ui.Main"
            android:exported="true"
            android:enabled="false"
            android:label="@string/share_in_label"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <!-- Alarms of the notifications; not reachable from other apps (their PendingIntents are the app's own) -->
        <receiver android:name=".ui.Alarms" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Home-screen widgets: nothing personal on them; exported only because the launcher must reach them -->
        <receiver android:name=".ui.NowWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/tile_now">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_now_info" />
        </receiver>
        <receiver android:name=".ui.RunningWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/active_title">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_running_info" />
        </receiver>
        <receiver android:name=".ui.PathWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/path_week_title">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_path_info" />
        </receiver>
        <receiver android:name=".ui.TileWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/widget_tile_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tile_info" />
        </receiver>
        <receiver android:name=".ui.ServicesWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/widget_services_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_services_info" />
        </receiver>
        <receiver android:name=".ui.KidWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/widget_kid_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_kid_info" />
        </receiver>
        <receiver android:name=".ui.SafeWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/tile_safe">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_safe_info" />
        </receiver>
        <receiver android:name=".ui.KitWidget" android:exported="true" android:permission="android.permission.BIND_APPWIDGET" android:label="@string/kit">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_kit_info" />
        </receiver>
        <!-- Choosing the part of Sprotyv a widget opens: reached by the launcher when the widget is placed;
             it accepts only Sprotyv's own widgets -->
        <activity android:name=".ui.TileWidgetSetup" android:exported="true" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- Lets the camera app write one photo into Sprotyv's cache; deleted right after reading -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
